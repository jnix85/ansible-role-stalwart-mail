{{ ansible_managed | comment }}
# Environment for the Stalwart service (read by systemd, root only).
# STALWART_RECOVERY_ADMIN is a fallback administrator that Stalwart
# honours at any time, so Ansible can always reach the management API.
STALWART_HOSTNAME={{ stalwart_hostname }}
STALWART_RECOVERY_ADMIN={{ stalwart_admin_user }}:{{ stalwart_admin_secret_hash }}
